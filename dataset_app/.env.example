# Local-only configuration. Copy to .env and fill in real values.
# Loaded by dataset_app/hooks_local.py via python-dotenv.
# Both .env and hooks_local.py are gitignored.

UPLOAD_BASE_URL=https://share.sugar-knight.com
UPLOAD_TOKEN=replace-me-with-real-token
UPLOAD_AUTH_SCHEME=Bearer
UPLOAD_PUBLIC=true
UPLOAD_7ZIP_PATH=C:/Program Files/7-Zip/7z.exe
UPLOAD_7ZIP_DICT_SIZE=256m
